+}
+static bool _b220_fast_tune() {
+    static const bool v = [](){
+        const char* e = std::getenv("UHD_AD9361_FAST_TUNE");
+        return e && e[0] == '1';
+    }();
+    return v;
+}
+#include <map>
+template <typename IO_T>
+static void _b220_cpoke(IO_T& io, uint32_t addr, uint8_t val) {
+    if (!_b220_fast_tune()) { io->poke8(addr, val); return; }
+    static std::map<uint32_t, int> cache;
+    auto it = cache.find(addr);
+    if (it != cache.end() && it->second == (int)val) return;
+    cache[addr] = (int)val;
+    io->poke8(addr, val);
+}
